[
  {
    "id": "button",
    "keywords": [
      "cta",
      "action",
      "submit",
      "primary action"
    ],
    "rules": [
      "one primary button per local decision",
      "use a visible pressed/focus state",
      "label by action rather than generic verbs"
    ],
    "avoid": [
      "five equal-weight buttons",
      "icon-only without name",
      "gradient fill by default"
    ]
  },
  {
    "id": "sidebar",
    "keywords": [
      "navigation",
      "app shell",
      "workspace",
      "persistent nav"
    ],
    "rules": [
      "keep active location obvious",
      "group related destinations",
      "collapse intentionally on narrow screens"
    ],
    "avoid": [
      "deep unexplained nesting",
      "tiny hit areas",
      "decorative navigation icons"
    ]
  },
  {
    "id": "command-palette",
    "keywords": [
      "command palette",
      "keyboard actions",
      "quick actions",
      "search commands"
    ],
    "rules": [
      "show searchable actions",
      "group by task",
      "preserve keyboard navigation",
      "provide clear empty state"
    ],
    "avoid": [
      "huge modal shell",
      "duplicate shortcuts",
      "hidden destructive actions"
    ]
  },
  {
    "id": "data-table",
    "keywords": [
      "table",
      "rows",
      "columns",
      "data grid",
      "records"
    ],
    "rules": [
      "align numeric data",
      "keep row density consistent",
      "support loading/empty/error",
      "allow responsive fallback"
    ],
    "avoid": [
      "horizontal overflow without strategy",
      "tiny unreadable text",
      "random column alignment"
    ]
  },
  {
    "id": "metric",
    "keywords": [
      "stat",
      "kpi",
      "summary number",
      "metric card"
    ],
    "rules": [
      "show context and time range",
      "highlight only important deltas",
      "use semantic states sparingly"
    ],
    "avoid": [
      "six identical metric cards",
      "fake trends",
      "unexplained colors"
    ]
  },
  {
    "id": "form",
    "keywords": [
      "input",
      "form",
      "field",
      "settings",
      "configuration"
    ],
    "rules": [
      "group fields by task",
      "show validation next to the field",
      "preserve entered values on failure"
    ],
    "avoid": [
      "placeholder-only labels",
      "late validation only",
      "mystery required fields"
    ]
  },
  {
    "id": "modal",
    "keywords": [
      "dialog",
      "confirmation",
      "sheet",
      "modal"
    ],
    "rules": [
      "use for focused interruption",
      "keep task-specific context",
      "provide predictable close path"
    ],
    "avoid": [
      "entire application in modal",
      "nested modals",
      "closing without state recovery"
    ]
  },
  {
    "id": "tabs",
    "keywords": [
      "tab navigation",
      "segmented navigation",
      "views"
    ],
    "rules": [
      "tabs switch related views",
      "active state has text and visual cue",
      "preserve scroll and context when practical"
    ],
    "avoid": [
      "using tabs for unrelated tasks",
      "hidden overflow without access",
      "too many tabs"
    ]
  },
  {
    "id": "toast",
    "keywords": [
      "notification",
      "status message",
      "feedback"
    ],
    "rules": [
      "announce important feedback accessibly",
      "keep duration appropriate",
      "provide action only when useful"
    ],
    "avoid": [
      "critical errors only in transient toast",
      "stacking dozens",
      "long messages"
    ]
  },
  {
    "id": "media-controls",
    "keywords": [
      "player controls",
      "video controls",
      "audio controls",
      "transport"
    ],
    "rules": [
      "controls remain discoverable",
      "primary transport is reachable by keyboard and touch",
      "show buffered/playing state clearly"
    ],
    "avoid": [
      "tiny controls",
      "autoplay surprises",
      "permanent chrome over content"
    ]
  },
  {
    "id": "file-tree",
    "keywords": [
      "files",
      "project tree",
      "explorer",
      "repository"
    ],
    "rules": [
      "active file is obvious",
      "folder nesting is readable",
      "loading and unavailable states are explicit"
    ],
    "avoid": [
      "deep nesting with no context",
      "invisible selection",
      "fake files"
    ]
  },
  {
    "id": "composer",
    "keywords": [
      "chat composer",
      "prompt input",
      "message composer",
      "assistant input"
    ],
    "rules": [
      "keep submit reachable",
      "show sending/disabled state",
      "support multiline input without trapping the viewport"
    ],
    "avoid": [
      "giant floating composer",
      "hidden attachment state",
      "button overload"
    ]
  }
]
